    "compare"
   ]
  },
  "一句话": {
   "part": [
    "headline"
   ]
  },
  "场景": {
   "part": [
    "headline"
   ]
  },
  "实物": {
   "part": [
    "headline"
   ]
  },
  "人": {
   "part": [
    "headline"
   ]
  },
  "地图": {
