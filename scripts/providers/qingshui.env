# 维护者出样片用青水：在仓库根目录 source scripts/providers/qingshui.env，三类生成都交给 qingshui.py。
# 只设适配命令；Key 仍只在环境变量 QINGSHUI_API_KEY 里（云端环境的变量，或本机 shell），不写进这里。
_aicv_qs="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/qingshui.py"
export AICV_IMAGE_CMD="python3 $_aicv_qs"
export AICV_VIDEO_CMD="python3 $_aicv_qs"
export AICV_TTS_CMD="python3 $_aicv_qs"
unset _aicv_qs
