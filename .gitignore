dist/
node_modules/
__pycache__/
.DS_Store
# 样片和风格包演示片的视频放在 Release，不进仓库，见 scripts/media.py
samples/*/*.mp4
packs/*/demo/*.mp4
# 案例：中间产物、能重新下载的素材、成品视频（成品放 Release，见 scripts/media.py）
cases/*/out/
cases/*/assets/dl/
cases/*/media/
# 配音和整片工具的演示片：只进分镜、逐字稿和代码；配音、timing.json、典型样片和成片不进
videos/*/vo/
videos/*/timing.json
videos/*/typical/
videos/*/out/
