   "lines": [
    {
     "t0": 0.86,
     "t1": 3.51,
     "text": "先弄清一件事：视频里的画面从哪来",
     "s": 0
    },
    {
     "t0": 4.13,
     "t1": 6.111,
     "text": "这个 Skill 把画面分成三类",
     "s": 1
    },
    {
     "t0": 6.731,
     "t1": 9.253,
     "text": "C 类，画面全部由代码算出来",
     "s": 2
    },
    {
     "t0": 9.253,
     "t1": 11.278,
     "text": "图形、文字、动画",
     "s": 2
    },
    {
     "t0": 11.898,
     "t1": 15.503,
     "text": "T 类，用真实素材：录像、录屏、照片、数据",
     "s": 3
    },
    {
     "t0": 16.123,
     "t1": 18.974,
     "text": "G 类，用 AI 生成的素材",
     "s": 4
    },
    {
     "t0": 18.974,
     "t1": 21.87,
     "text": "生图、生视频、语音合成",
     "s": 4
    },
    {
     "t0": 22.49,
     "t1": 24.296,
     "text": "写实的人脸、真人口播",
     "s": 5
    },
    {
     "t0": 24.296,
     "t1": 27.333,
     "text": "代码画不出来，要靠 T 类或 G 类",
     "s": 5
    },
    {
     "t0": 27.953,
     "t1": 30.691,
     "text": "不管哪一类，最后都由代码排进时间线",
     "s": 6
    },
    {
     "t0": 30.691,
     "t1": 31.757,
     "text": "合成一条片子",
     "s": 6
    },
    {
     "t0": 32.377,
     "t1": 33.832,
     "text": "代码画面有一条规矩",
     "s": 7
    },
    {
     "t0": 33.832,
     "t1": 35.848,
     "text": "每一帧只由时间 t 决定",
     "s": 7
    },
    {
     "t0": 36.468,
     "t1": 38.563,
     "text": "给它一个时间，它就画出那一帧",
     "s": 8
    },
    {
     "t0": 38.563,
     "t1": 40.934,
     "text": "同一个 t，永远画出同一张",
     "s": 8
    },
    {
     "t0": 41.554,
     "t1": 44.196,
     "text": "所以能直接跳到第 7 秒检查",
     "s": 9
    },
    {
     "t0": 44.196,
     "t1": 46.104,
     "text": "逐帧导出也不会掉帧",
     "s": 9
    }
