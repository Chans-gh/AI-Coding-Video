   "lines": [
    {
     "t0": 0.86,
     "t1": 3.675,
     "text": "先弄清一件事：视频里的画面从哪来",
     "s": 0
    },
    {
     "t0": 4.295,
     "t1": 6.797,
     "text": "这个 Skill 把画面分成三类",
     "s": 1
    },
    {
     "t0": 7.417,
     "t1": 9.898,
     "text": "C 类，画面全部由代码算出来",
     "s": 2
    },
    {
     "t0": 9.898,
     "t1": 11.978,
     "text": "图形、文字、动画",
     "s": 2
    },
    {
     "t0": 12.598,
     "t1": 16.961,
     "text": "T 类，用真实素材：录像、录屏、照片、数据",
     "s": 3
    },
    {
     "t0": 16.961,
     "t1": 19.751,
     "text": "比如这张老照片，配上一张深度图",
     "s": 3
    },
    {
     "t0": 19.751,
     "t1": 21.205,
     "text": "就能推出立体感",
     "s": 3
    },
    {
     "t0": 21.825,
     "t1": 23.807,
     "text": "G 类，用 AI 生成的素材",
     "s": 4
    },
    {
     "t0": 23.807,
     "t1": 26.559,
     "text": "生图、生视频、语音合成",
     "s": 4
    },
    {
     "t0": 26.559,
     "t1": 29.068,
     "text": "这张雨巷，就是生图",
     "s": 4
    },
    {
     "t0": 29.688,
     "t1": 31.97,
     "text": "写实的人脸、真人口播",
     "s": 5
    },
    {
     "t0": 31.97,
     "t1": 34.537,
     "text": "代码画不出来，要靠 T 类或 G 类",
     "s": 5
    },
    {
     "t0": 35.157,
     "t1": 38.064,
     "text": "不管哪一类，最后都由代码排进时间线",
     "s": 6
    },
    {
     "t0": 38.064,
     "t1": 39.37,
     "text": "合成一条片子",
     "s": 6
    },
    {
     "t0": 39.99,
     "t1": 41.616,
     "text": "代码画面有一条规矩",
     "s": 7
    },
    {
     "t0": 41.616,
     "t1": 43.418,
     "text": "每一帧只由时间 t 决定",
     "s": 7
    },
    {
     "t0": 44.038,
     "t1": 46.09,
     "text": "给它一个时间，它就画出那一帧",
     "s": 8
    },
    {
     "t0": 46.09,
     "t1": 48.971,
     "text": "同一个 t，永远画出同一张",
     "s": 8
    },
    {
     "t0": 49.591,
     "t1": 52.263,
     "text": "所以能直接跳到第 7 秒检查",
     "s": 9
    },
    {
     "t0": 52.263,
     "t1": 54.187,
     "text": "逐帧导出也不会掉帧",
     "s": 9
    }
   ]
