    {
     "t0": 0.66,
     "t1": 3.505,
     "text": "你好，欢迎来到用 AI 做视频的第一课",
     "s": 0
    },
    {
     "t0": 3.925,
     "t1": 6.942,
     "text": "我是这门课的讲师，一个 AI 生成的虚拟形象",
     "s": 1
    },
    {
     "t0": 7.362,
     "t1": 9.195,
     "text": "这节课学三件事：第一",
     "s": 3
    },
    {
     "t0": 9.195,
     "t1": 11.498,
     "text": "装上 AI Coding Video 这个 Skill",
     "s": 3
    },
    {
     "t0": 11.918,
     "t1": 13.461,
     "text": "第二，选一种风格",
     "s": 4
    },
    {
     "t0": 13.881,
     "t1": 16.422,
     "text": "第三，让 AI 编程助手写代码",
     "s": 5
    },
    {
     "t0": 16.422,
     "t1": 17.976,
     "text": "出一条你自己的短片",
     "s": 5
    }
   ]
