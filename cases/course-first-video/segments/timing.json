    {
     "t0": 3.411,
     "t1": 5.848,
     "text": "这是国际空间站拍下的真实云海",
     "s": 1
    },
    {
     "t0": 5.848,
     "t1": 8.536,
     "text": "海水蒸发，凝成云，再落成雨",
     "s": 1
    },
    {
     "t0": 9.056,
     "t1": 12.418,
     "text": "下面这条 15 秒的水循环短片讲的是同一件事",
     "s": 2
