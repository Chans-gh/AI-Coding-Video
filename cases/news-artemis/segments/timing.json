    {
     "ss": 71.758,
     "t": 5.221,
     "at": 36.882
    }
   ],
   "lines": [
    {
     "t0": 2.06,
     "t1": 3.489,
     "text": "它没有直接奔月",
     "s": 0
    },
    {
     "t0": 5.209,
     "t1": 9.746,
     "text": "头一天，飞船先在绕地球的大椭圆轨道上检查各个系统",
     "s": 1
    },
    {
     "t0": 11.466,
     "t1": 14.859,
     "text": "第二天，服务舱发动机点火五分五十五秒",
     "s": 2
    },
    {
     "t0": 14.859,
     "t1": 16.764,
     "text": "飞船进入奔月轨道",
     "s": 2
    },
    {
     "t0": 18.484,
     "t1": 20.267,
     "text": "这条路叫自由返回轨道",
     "s": 3
    },
    {
     "t0": 20.267,
     "t1": 23.832,
     "text": "飞船绕到月球背面，借月球的引力拐一个弯",
     "s": 3
    },
    {
     "t0": 23.832,
     "t1": 26.26,
     "text": "地球的引力自然会把它拉回家",
     "s": 3
    },
    {
     "t0": 26.26,
     "t1": 27.587,
     "text": "不用再大幅点火",
     "s": 3
    },
    {
     "t0": 29.307,
     "t1": 31.444,
     "text": "整个航程只做了几次小的修正",
     "s": 4
    },
    {
     "t0": 31.444,
     "t1": 35.222,
     "text": "最小的一次，速度只改变了每秒零点四九米",
     "s": 4
    },
    {
     "t0": 36.942,
     "t1": 40.697,
     "text": "屏幕上的轨迹，来自喷气推进实验室的星历数据",
     "s": 5
    },
    {
     "t0": 40.697,
     "t1": 42.044,
     "text": "每十分钟一个点",
     "s": 5
    }
   ]
  },
