   "lines": [
    {
     "t0": 2.06,
     "t1": 3.916,
     "text": "四月六日，飞掠月球",
     "s": 0
    },
    {
     "t0": 6.236,
     "t1": 8.7,
     "text": "美国东部时间下午一点五十六分",
     "s": 1
    },
    {
     "t0": 8.7,
     "t1": 12.622,
     "text": "乘组打破了阿波罗 13 号保持了五十六年的距离纪录",
     "s": 1
    },
    {
     "t0": 14.942,
     "t1": 19.012,
     "text": "傍晚六点四十一分，他们看着地球沉到月球的地平线下面",
     "s": 2
    },
    {
     "t0": 21.332,
     "t1": 23.975,
     "text": "三分钟后，飞船转到月球背面",
     "s": 3
    },
    {
     "t0": 23.975,
     "t1": 26.91,
     "text": "和地球断了联系，整整四十一分钟",
     "s": 3
    },
    {
     "t0": 29.23,
     "t1": 32.86,
     "text": "七点整，离月面最近，大约 6,545 公里",
     "s": 4
    },
    {
     "t0": 32.86,
     "t1": 34.809,
     "text": "两分钟后，离地球最远",
     "s": 4
    },
    {
     "t0": 37.129,
     "t1": 41.75,
     "text": "窗外是东方盆地，一个宽将近一千公里的古老撞击盆地",
     "s": 5
    }
   ]
  },
  {
   "title": "和阿波罗比",
   "dur": 40.0,
   "vo": [
