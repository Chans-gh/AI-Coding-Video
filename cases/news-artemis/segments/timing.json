     "at": 31.913
    }
   ],
   "lines": [
    {
     "t0": 5.12,
     "t1": 8.534,
     "text": "美国东部时间四月一日傍晚六点三十五分",
     "s": 0
    },
    {
     "t0": 8.534,
     "t1": 13.431,
     "text": "太空发射系统火箭从肯尼迪航天中心 39B 发射台起飞",
     "s": 0
    },
    {
     "t0": 15.001,
     "t1": 17.747,
     "text": "飞船里坐着四个人：指令长里德·怀斯曼",
     "s": 1
    },
    {
     "t0": 17.747,
     "t1": 19.527,
     "text": "驾驶员维克多·格洛弗",
     "s": 1
    },
    {
     "t0": 19.527,
     "t1": 21.679,
     "text": "任务专家克里斯蒂娜·科赫",
     "s": 1
    },
    {
     "t0": 21.679,
     "t1": 24.202,
     "text": "还有加拿大航天局的杰里米·汉森",
     "s": 1
    },
    {
     "t0": 25.772,
     "t1": 27.738,
     "text": "起飞七秒，火箭越过发射塔",
     "s": 2
    },
    {
     "t0": 27.738,
     "t1": 30.743,
     "text": "两分零九秒，两枚固体助推器分离",
     "s": 2
    },
    {
     "t0": 32.033,
     "t1": 33.851,
     "text": "这是半个多世纪以来",
     "s": 3
    },
    {
     "t0": 33.851,
     "t1": 35.595,
     "text": "人类第一次飞向月球",
     "s": 3
    }
   ]
  },
  {
   "title": "航线",
   "dur": 50.0,
   "vo": [
    {
     "ss": 43.353,
     "t": 2.003,
     "at": 2
    },
    {
     "ss": 45.566,
     "t": 4.579,
     "at": 5.603
    },
    {
     "ss": 50.055,
     "t": 6.047,
