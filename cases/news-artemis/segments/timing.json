   "lines": [
    {
     "t0": 1.56,
     "t1": 2.393,
     "text": "接下来呢？",
     "s": 0
    },
    {
     "t0": 2.918,
     "t1": 4.475,
     "text": "按 NASA 十月公布的计划",
     "s": 0
    },
    {
     "t0": 4.475,
     "t1": 7.771,
     "text": "2027 年，Artemis III 在近地轨道上",
     "s": 0
    },
    {
     "t0": 7.771,
     "t1": 9.436,
     "text": "试验和登月器对接",
     "s": 0
    },
    {
     "t0": 11.356,
     "t1": 13.773,
     "text": "2028 年，Artemis IV",
     "s": 1
    },
    {
     "t0": 13.773,
     "t1": 15.665,
     "text": "降落在月球南极附近",
     "s": 1
    },
    {
     "t0": 17.585,
     "t1": 20.5,
     "text": "再往后，NASA 的目标是在月面长期驻留",
     "s": 2
    },
    {
     "t0": 22.42,
     "t1": 24.903,
     "text": "这几个画面是 AI 生成的示意图",
     "s": 3
    },
    {
     "t0": 24.903,
     "t1": 26.322,
     "text": "还没有真实的影像",
     "s": 3
    }
   ]
