   "lines": [
    {
     "t0": 1.26,
     "t1": 3.857,
     "text": "406,771 公里",
     "s": 0
    },
    {
     "t0": 4.477,
     "t1": 6.664,
     "text": "这是人类离开地球最远的一次",
     "s": 1
    },
    {
     "t0": 7.284,
     "t1": 8.903,
     "text": "2026 年四月",
     "s": 2
    },
    {
     "t0": 8.903,
     "t1": 12.319,
     "text": "Artemis II 的四名宇航员绕到月球背面",
     "s": 2
    },
    {
     "t0": 12.319,
     "t1": 13.831,
     "text": "又平安回到了地球",
     "s": 2
    }
   ]
  },
  {
   "title": "片头",
   "dur": 10.0,
   "vo": [
    {
     "ss": 12.238,
     "t": 1.348,
     "at": 3.5
    },
    {
     "ss": 13.665,
     "t": 3.177,
     "at": 4.848
    }
   ],
   "lines": [
    {
     "t0": 3.56,
     "t1": 4.788,
     "text": "欢迎收看星海速递",
     "s": 0
    },
    {
     "t0": 4.908,
     "t1": 7.965,
     "text": "今天，我们回顾这趟十天的绕月旅程",
     "s": 1
    }
   ]
  },
  {
   "title": "发射",
   "dur": 45.0,
   "vo": [
    {
     "ss": 17.124,
     "t": 7.961,
     "at": 5
    },
