   "lines": [
    {
     "t0": 3.12,
     "t1": 5.717,
     "text": "四月十日，太平洋时间下午五点零七分",
     "s": 0
    },
    {
     "t0": 5.717,
     "t1": 7.832,
     "text": "飞船在圣迭戈外海溅落",
     "s": 0
    },
    {
     "t0": 9.702,
     "t1": 13.227,
     "text": "直升机把四个人送上了美国海军的约翰·P·穆尔萨号",
     "s": 1
    },
    {
     "t0": 14.817,
     "t1": 18.712,
     "text": "十天，总航程 1,118,624 公里",
     "s": 2
    },
    {
     "t0": 20.302,
     "t1": 23.085,
     "text": "回到休斯敦，乘组在发布会上这样说",
     "s": 3
    }
   ]
  },
