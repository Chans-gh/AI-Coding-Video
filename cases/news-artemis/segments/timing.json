   "lines": [
    {
     "t0": 1.237,
     "t1": 3.686,
     "text": "406,771 公里",
     "s": 0
    },
    {
     "t0": 4.276,
     "t1": 6.65,
     "text": "这是人类离开地球最远的一次",
     "s": 1
    },
    {
     "t0": 7.24,
     "t1": 8.91,
     "text": "2026 年四月",
     "s": 2
    },
    {
     "t0": 8.91,
     "t1": 12.434,
     "text": "Artemis II 的四名宇航员绕到月球背面",
     "s": 2
    },
    {
     "t0": 12.434,
     "t1": 13.993,
     "text": "又平安回到了地球",
     "s": 2
    }
   ]
  },
  {
   "title": "片头",
   "dur": 10.0,
   "vo": [
