   "lines": [
    {
     "t0": 3.06,
     "t1": 5.691,
     "text": "四月十日，太平洋时间下午五点零七分",
     "s": 0
    },
    {
     "t0": 5.691,
     "t1": 7.834,
     "text": "飞船在圣迭戈外海溅落",
     "s": 0
    },
    {
     "t0": 9.454,
     "t1": 13.226,
     "text": "直升机把四个人送上了美国海军的约翰·P·穆尔萨号",
     "s": 1
    },
    {
     "t0": 14.846,
     "t1": 18.465,
     "text": "十天，总航程 1,118,624 公里",
     "s": 2
    },
    {
     "t0": 20.085,
     "t1": 22.674,
     "text": "回到休斯敦，乘组在发布会上这样说",
     "s": 3
    }
   ]
  },
