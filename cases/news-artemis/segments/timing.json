   "lines": [
    {
     "t0": 2.12,
     "t1": 3.715,
     "text": "四月六日，飞掠月球",
     "s": 0
    },
    {
     "t0": 6.005,
     "t1": 8.639,
     "text": "美国东部时间下午一点五十六分",
     "s": 1
    },
    {
     "t0": 8.639,
     "t1": 12.832,
     "text": "乘组打破了阿波罗 13 号保持了五十六年的距离纪录",
     "s": 1
    },
    {
     "t0": 15.402,
     "t1": 19.409,
     "text": "傍晚六点四十一分，他们看着地球沉到月球的地平线下面",
     "s": 2
    },
    {
     "t0": 21.699,
     "t1": 24.407,
     "text": "三分钟后，飞船转到月球背面",
     "s": 3
    },
    {
     "t0": 24.407,
     "t1": 27.413,
     "text": "和地球断了联系，整整四十一分钟",
     "s": 3
    },
    {
     "t0": 29.983,
     "t1": 33.507,
     "text": "七点整，离月面最近，大约 6,545 公里",
     "s": 4
    },
    {
     "t0": 33.507,
     "t1": 35.399,
     "text": "两分钟后，离地球最远",
     "s": 4
    },
    {
     "t0": 37.689,
     "t1": 42.587,
     "text": "窗外是东方盆地，一个宽将近一千公里的古老撞击盆地",
     "s": 5
    }
   ]
  },
