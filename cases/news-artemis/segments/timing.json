     "ss": 12.033,
     "t": 1.241,
     "at": 3.5
    },
    {
     "ss": 13.184,
     "t": 3.28,
     "at": 4.741
    }
   ],
   "lines": [
    {
     "t0": 3.62,
     "t1": 4.771,
     "text": "欢迎收看星海速递",
     "s": 0
    },
    {
     "t0": 4.861,
     "t1": 8.051,
     "text": "今天，我们回顾这趟十天的绕月旅程",
     "s": 1
    }
   ]
  },
  {
   "title": "发射",
   "dur": 45.0,
   "vo": [
