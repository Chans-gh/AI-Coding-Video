     "at": 24.831
    },
    {
     "ss": 40.421,
     "t": 3.434,
     "at": 31.25
    }
   ],
   "lines": [
    {
     "t0": 5.06,
     "t1": 8.281,
     "text": "美国东部时间四月一日傍晚六点三十五分",
     "s": 0
    },
    {
     "t0": 8.281,
     "t1": 12.901,
     "text": "太空发射系统火箭从肯尼迪航天中心 39B 发射台起飞",
     "s": 0
    },
    {
     "t0": 14.221,
     "t1": 17.012,
     "text": "飞船里坐着四个人：指令长里德·怀斯曼",
     "s": 1
    },
    {
     "t0": 17.012,
     "t1": 18.82,
     "text": "驾驶员维克多·格洛弗",
     "s": 1
    },
    {
     "t0": 18.82,
     "t1": 21.007,
     "text": "任务专家克里斯蒂娜·科赫",
     "s": 1
    },
    {
     "t0": 21.007,
     "t1": 23.571,
     "text": "还有加拿大航天局的杰里米·汉森",
     "s": 1
    },
    {
     "t0": 24.891,
     "t1": 26.908,
     "text": "起飞七秒，火箭越过发射塔",
     "s": 2
    },
    {
     "t0": 26.908,
     "t1": 29.99,
     "text": "两分零九秒，两枚固体助推器分离",
     "s": 2
    },
    {
     "t0": 31.31,
     "t1": 33.001,
     "text": "这是半个多世纪以来",
     "s": 3
    },
    {
     "t0": 33.001,
     "t1": 34.624,
     "text": "人类第一次飞向月球",
     "s": 3
    }
   ]
  },
  {
   "title": "航线",
   "dur": 50.0,
   "vo": [
    {
     "ss": 43.906,
     "t": 1.549,
     "at": 2
    },
    {
     "ss": 45.822,
     "t": 4.657,
     "at": 5.149
    },
    {
     "ss": 50.695,
     "t": 5.418,
     "at": 11.406
    },
    {
     "ss": 56.245,
     "t": 9.222,
     "at": 18.424
    },
    {
     "ss": 65.611,
     "t": 6.036,
     "at": 29.247
